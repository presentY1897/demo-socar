generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── 시드 메타 ───────────────────────────

// 시드 데이터의 버전 마커 — 코드의 SEED_VERSION이 이 값보다 크면 부팅 시 1회 재시드.
// (Render 무료 티어는 셸이 없어 배포 후 수동 시드가 불가능하다)
model SeedMeta {
  id       Int      @id @default(1)
  version  Int
  seededAt DateTime @default(now())
}

// ─────────────────────────── 사용자 / 법인 ───────────────────────────

enum Role {
  USER // 개인 이용자
  CORP_MEMBER // 법인 임직원
  CORP_ADMIN // 법인 배차 담당자
  OPS_ADMIN // 쏘카 운영 어드민
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(USER)
  corporationId String?
  createdAt     DateTime @default(now())

  corporation      Corporation?      @relation(fields: [corporationId], references: [id])
  reservations     Reservation[]
  coupons          Coupon[]
  creditLedger     CreditLedger[]
  dispatchRequests DispatchRequest[] @relation("requester")
  dispatchDecided  DispatchRequest[] @relation("decider")
  inquiries        Inquiry[]
}

model Corporation {
  id            String @id @default(cuid())
  name          String
  officeAddress String
  officeLat     Float
  officeLng     Float

  members          User[]
  dispatchRequests DispatchRequest[]
  zones            Zone[] // 기업 전용존 (사옥 주차장 등)
  vehicles         Vehicle[] // 법인 소유/장기렌트 차량 (FMS 모델)
}

// ─────────────────────────── 존 / 차량 / 요금제 ───────────────────────────

model Zone {
  id            String  @id @default(cuid())
  name          String
  region        String // 도로망 그래프 파일 키 (예: "seoul", "busan")
  address       String
  lat           Float
  lng           Float
  capacity      Int
  corporationId String? // 값이 있으면 기업 전용존 — 일반 이용자에게 비노출

  corporation Corporation?  @relation(fields: [corporationId], references: [id])
  vehicles    Vehicle[]
  onewayReturns Reservation[] @relation("returnZone") // 이 존으로 반납되는 편도 예약
}

model PricingPlan {
  id                   String @id @default(cuid())
  name                 String // 예: "경형", "준중형 EV"
  baseHourlyKrw        Int // 주중 시간당 대여요금
  weekendHourlyKrw     Int // 주말 시간당 대여요금
  perKmKrw             Int // km당 주행요금 (반납 후 정산)
  insuranceLightKrw    Int // 시간당 차량손해면책 보험료
  insuranceStandardKrw Int
  insuranceFullKrw     Int

  vehicles Vehicle[]
}

enum FuelType {
  EV
  GASOLINE
  HYBRID
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE // 정비 중 — 예약 불가
}

model Vehicle {
  id            String        @id @default(cuid())
  modelName     String
  plateNo       String        @unique
  fuel          FuelType
  seats         Int
  status        VehicleStatus @default(AVAILABLE)
  imageUrl      String?
  zoneId        String
  planId        String
  corporationId String? // 값이 있으면 법인 소유/장기렌트 차량 (FMS) — 이용 과금 없음

  // 가상 스마트키(M1-4) 조작 결과를 담는 임시 상태 필드.
  // ⚠️ M3-1에서 VehicleTelemetry(연료·주행거리·좌표 포함)로 통합 예정 — 그때 이 두 필드는 제거된다.
  doorLocked Boolean @default(true)
  engineOn   Boolean @default(false)

  zone               Zone                @relation(fields: [zoneId], references: [id])
  plan               PricingPlan         @relation(fields: [planId], references: [id])
  corporation        Corporation?        @relation(fields: [corporationId], references: [id])
  reservations       Reservation[]
  dispatchCandidates DispatchCandidate[]
  controlLogs        VehicleControlLog[]
  inquiries          Inquiry[]
}

// ─────────────────────────── 예약 / 대여 ───────────────────────────

enum ReservationStatus {
  CONFIRMED // 결제 완료, 이용 전
  IN_USE // 대여 중
  COMPLETED // 반납 + 정산 완료
  CANCELED
}

enum InsuranceTier {
  LIGHT
  STANDARD
  FULL
}

model Reservation {
  id        String            @id @default(cuid())
  userId    String
  vehicleId String
  startAt   DateTime          @db.Timestamptz(3)
  endAt     DateTime          @db.Timestamptz(3)
  status    ReservationStatus @default(CONFIRMED)
  insurance InsuranceTier
  returnZoneId String? // 편도 예약: 반납 존 (null = 왕복)

  // 부름(탁송) 수령: 지정 위치로 배달, 이용 후 같은 자리 회수 (편도와 배타)
  deliveryLat   Float?
  deliveryLng   Float?
  deliveryLabel String?

  // 결제 시점 요금 스냅샷
  rentalFeeKrw    Int
  insuranceFeeKrw Int
  onewayFeeKrw    Int     @default(0)
  deliveryFeeKrw  Int     @default(0)
  discountKrw     Int     @default(0)
  creditUsedKrw   Int     @default(0)
  totalUpfrontKrw Int
  couponId        String? @unique

  createdAt  DateTime  @default(now())
  canceledAt DateTime?

  user       User    @relation(fields: [userId], references: [id])
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  returnZone Zone?   @relation("returnZone", fields: [returnZoneId], references: [id])
  coupon     Coupon? @relation(fields: [couponId], references: [id])
  payments Payment[]
  rental   Rental?
  dispatch DispatchRequest?

  // 시간 겹침 방지는 마이그레이션의 EXCLUDE USING GIST 제약이 최종 방어선
  @@index([vehicleId, startAt])
  @@index([userId, startAt])
}

enum RentalStatus {
  IN_USE
  RETURN_PENDING // 반납 접수, 주행요금 정산 대기
  COMPLETED
}

model Rental {
  id            String       @id @default(cuid())
  reservationId String       @unique
  status        RentalStatus @default(IN_USE)
  startedAt     DateTime     @default(now()) // 첫 문열기(스마트키)
  returnedAt    DateTime?
  distanceKm    Float?
  lateMinutes   Int          @default(0)
  driveFeeKrw   Int?
  lateFeeKrw    Int?

  reservation      Reservation         @relation(fields: [reservationId], references: [id])
  conditionReports ConditionReport[]
  controlLogs      VehicleControlLog[]
  incidents        IncidentReport[]
  inquiries        Inquiry[]
}

// ─────────────────────────── 이용 플로우 (체크인/아웃 · 스마트키) ───────────────────────────

enum ConditionPhase {
  CHECK_IN // 이용 시작 전 차량 상태 보고 — 제출해야 스마트키 활성화
  CHECK_OUT // 반납 주차 상태 보고 — 제출해야 반납 가능
}

model ConditionReport {
  id          String         @id @default(cuid())
  rentalId    String
  phase       ConditionPhase
  notes       String? // 차량 상태 메모 (흠집/청결 등)
  parkingNote String? // 반납 위치 설명 (층/구역) — CHECK_OUT 전용
  createdAt   DateTime       @default(now())

  rental Rental           @relation(fields: [rentalId], references: [id])
  photos ConditionPhoto[]

  @@index([rentalId, phase])
}

// 클라이언트에서 1280px/JPEG로 압축한 사진을 base64 텍스트로 DB에 보관한다
// (외부 스토리지 의존 없이 무료 티어에서 동작 — project-review §6-Q2).
model ConditionPhoto {
  id        String   @id @default(cuid())
  reportId  String
  mime      String // 예: "image/jpeg"
  data      String // base64 인코딩 원본 (압축 후 장당 ~200KB 제한)
  bytes     Int // 디코딩 기준 바이트 수
  createdAt DateTime @default(now())

  report ConditionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

enum VehicleControlAction {
  UNLOCK // 문 열기
  LOCK // 문 잠금
  HAZARD // 비상등
  HORN // 경적
  IGNITION_ON // 시동 켜기
  IGNITION_OFF // 시동 끄기
}

model VehicleControlLog {
  id        String               @id @default(cuid())
  rentalId  String
  vehicleId String
  action    VehicleControlAction
  at        DateTime             @default(now())

  rental  Rental  @relation(fields: [rentalId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([rentalId, at])
  @@index([vehicleId, at])
}

// ─────────────────────────── 문의 / 사고 접수 ───────────────────────────

enum InquiryCategory {
  VEHICLE // 차량 상태·장비
  RESERVATION // 예약·결제
  RETURN // 반납·정산
  ACCIDENT // 사고·보험
  ETC
}

enum InquiryStatus {
  OPEN // 접수 — 운영 답변 대기
  ANSWERED // 운영 백오피스(M3) 문의함에서 답변 완료
}

model Inquiry {
  id         String          @id @default(cuid())
  userId     String
  vehicleId  String? // 차량 문의인 경우
  rentalId   String? // 이용 중 문의인 경우
  category   InquiryCategory
  body       String
  status     InquiryStatus   @default(OPEN)
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime        @default(now())

  user    User     @relation(fields: [userId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  rental  Rental?  @relation(fields: [rentalId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum IncidentStatus {
  RECEIVED // 접수
  PROCESSING // 처리 중
  CLOSED // 종결
}

// 사고 접수(모의) — 가입 면책상품/자기부담금 안내는 예약의 insurance 스냅샷에서 파생한다
model IncidentReport {
  id          String         @id @default(cuid())
  rentalId    String
  description String
  status      IncidentStatus @default(RECEIVED)
  createdAt   DateTime       @default(now())

  rental Rental          @relation(fields: [rentalId], references: [id])
  photos IncidentPhoto[]

  @@index([rentalId])
}

// ConditionPhoto와 같은 저장 규격(압축 base64) — 업로드 경로(M1-2)를 공유한다
model IncidentPhoto {
  id         String   @id @default(cuid())
  incidentId String
  mime       String
  data       String
  bytes      Int
  createdAt  DateTime @default(now())

  incident IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// ─────────────────────────── 결제 / 할인 ───────────────────────────

enum PaymentKind {
  UPFRONT // 대여요금 선결제
  DRIVE_SETTLEMENT // 반납 후 주행요금 정산
  PENALTY // 지연 반납 페널티
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  reservationId  String
  kind           PaymentKind
  amountKrw      Int
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique
  cardLast4      String?
  approvedAt     DateTime?
  failReason     String?
  createdAt      DateTime      @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model Coupon {
  id          String    @id @default(cuid())
  userId      String
  name        String
  discountKrw Int
  expiresAt   DateTime
  usedAt      DateTime?

  user        User         @relation(fields: [userId], references: [id])
  reservation Reservation?
}

enum CreditReason {
  SIGNUP_BONUS
  USE
  REFUND
  ADMIN
}

model CreditLedger {
  id            String       @id @default(cuid())
  userId        String
  deltaKrw      Int // 양수 = 적립, 음수 = 사용
  reason        CreditReason
  memo          String?
  reservationId String?
  createdAt     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─────────────────────────── 법인 배차 (오피스) ───────────────────────────

enum DispatchStatus {
  REQUESTED // 임직원 요청 접수
  RECOMMENDED // 후보 추천 완료, 담당자 결정 대기
  APPROVED // 담당자 승인 → 예약 생성됨
  REJECTED
  CANCELED
}

model DispatchRequest {
  id            String         @id @default(cuid())
  corporationId String
  requesterId   String
  purpose       String // 예: "거래처 미팅 (판교)"
  originLabel   String // 출발지 표기 (보통 오피스)
  originLat     Float
  originLng     Float
  desiredStartAt DateTime
  desiredEndAt   DateTime
  status        DispatchStatus @default(REQUESTED)

  reservationId String?   @unique // 승인 시 생성된 예약
  decidedById   String?
  decidedAt     DateTime?
  rejectReason  String?
  createdAt     DateTime  @default(now())

  corporation Corporation         @relation(fields: [corporationId], references: [id])
  requester   User                @relation("requester", fields: [requesterId], references: [id])
  decidedBy   User?               @relation("decider", fields: [decidedById], references: [id])
  reservation Reservation?        @relation(fields: [reservationId], references: [id])
  candidates  DispatchCandidate[]
}

model DispatchCandidate {
  id            String   @id @default(cuid())
  requestId     String
  vehicleId     String
  rank          Int
  score         Float
  isDedicated   Boolean  @default(false) // 법인 전용 차량 여부
  walkSeconds   Int // 요청자 → 차량 존까지 이동 시간 (길찾기 추정)
  walkMeters    Int
  bufferMinutes Int // 직전 예약 반납 예정 시각과의 여유
  lateRiskPct   Float // 직전 이용 차량의 지연 반납 리스크
  reasons       Json // 추천 근거 문장 배열
  createdAt     DateTime @default(now())

  request DispatchRequest @relation(fields: [requestId], references: [id])
  vehicle Vehicle         @relation(fields: [vehicleId], references: [id])

  @@unique([requestId, vehicleId])
}
